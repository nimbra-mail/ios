<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (INFOPLIST_KEY_* in project.yml). -->
	<key>UIAppFonts</key>
	<array>
		<string>Geist-Regular.ttf</string>
		<string>Geist-Medium.ttf</string>
		<string>Geist-SemiBold.ttf</string>
		<string>GeistMono-Medium.ttf</string>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
	</array>
	<!-- bg/list, light or dark, so the first frame matches the app. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>BgList</string>
	</dict>
	<!-- The sign-in redirects: Google's iOS client (its id reversed) and Microsoft's
	     msauth.<bundle id>. Only the sign-in session's own callback finishes a sign-in;
	     the app opens no link with these schemes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.riangle.nimbra.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.riangle.nimbra.microsoft</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<!-- From Config/OAuth.xcconfig; read by Nimbra/Engine/OAuthConfig.swift. Empty when
	     the build has none. -->
	<key>NimbraGoogleClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>NimbraMicrosoftClientID</key>
	<string>$(MICROSOFT_CLIENT_ID)</string>
	<!-- Notifications: the background refresh that checks for mail, brings snoozes back and
	     sends what is due (Nimbra/Background/BackgroundRefresh.swift). No push server. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.riangle.nimbra.refresh</string>
	</array>
</dict>
</plist>
